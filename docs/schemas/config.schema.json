      "type": "string"
    },
    "mode": {
      "$ref": "#/$defs/RunMode"
    },
    "mri": {
      "$ref": "#/$defs/MRIInput"
    },
    "outputs": {
      "$ref": "#/$defs/OutputConfig"
    },
    "stages": {
      "$ref": "#/$defs/StageToggles"
    },
    "tools": {
