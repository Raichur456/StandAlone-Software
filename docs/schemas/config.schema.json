{
  "$defs": {
    "Dcm2niixConfig": {
      "additionalProperties": false,
      "properties": {
        "executable": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Executable"
        },
        "output_filename": {
          "default": "converted",
          "title": "Output Filename",
          "type": "string"
        },
        "bids_sidecar": {
          "default": true,
          "title": "Bids Sidecar",
          "type": "boolean"
        },
        "extra_args": {
          "items": {
            "type": "string"
          },
          "title": "Extra Args",
          "type": "array"
        },
        "timeout_seconds": {
          "default": 1800,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "Dcm2niixConfig",
      "type": "object"
    },
    "MRIInput": {
